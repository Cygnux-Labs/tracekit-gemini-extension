#!/bin/sh
# Gemini CLI hook entry point for the Tracekit extension: Tracekit's v2 Gemini CLI hook
# (tracekit.integrations.harness_hooks), as `tracekit init --dev --v2 --agent gemini` wires it, with the hook event
# hooks/hooks.json names as its argument. Needs tracekit-ai 1.4.2 or later:
#   pip install tracekit-ai && tracekit init --dev --v2 --no-hooks     (or a v2 system-mode signer)
# Python runs isolated (-I), so the project directory and PYTHON* variables never decide which tracekit runs. Gemini
# CLI loads a project's .env into the environment hooks get, so the variables that would pick the interpreter or the
# signer (TRACEKIT_PYTHON, TRACEKIT_SIGNER*, TRACEKIT_RUNTIME_DIR) are dropped: those come only from the root-owned
# system config, your PATH and your own dev signer.
# Exit 0 lets the event proceed. Only a BeforeTool is ever blocked (2): a hook that starts but cannot finish blocks the
# call. Any other event that fails exits 1, a warning Gemini CLI shows, with nothing on stdout: Gemini reads a deny on
# stdout at any exit status, and on BeforeAgent that discards your prompt, on AfterTool it hides the tool's result.
# In system mode (/etc/tracekit/client.json exists) only the root-owned runtime runs the hook; PATH is ignored. If it
# cannot run the hook the call is blocked, unless that config sets fail_mode open.
# Otherwise the hook runs in the first Python that imports tracekit (user site-packages added back for
# `pip install --user`) of: the one the `tracekit` command on PATH runs with, python3, python. A tracekit before 1.4.2,
# or one whose hook won't import, blocks the call. With none, the call is blocked once Tracekit is set up for this user
# (the dev signer's data dir exists, which `tracekit init --dev --v2` creates); before that every event says so and
# proceeds, unrecorded.
HOOK=tracekit.integrations.harness_hooks
SYSTEM_CONFIG=/etc/tracekit/client.json
SYSTEM_PYTHON=/opt/tracekit/bin/python
EV=${1:-}
unset TRACEKIT_PYTHON TRACEKIT_SIGNER TRACEKIT_SIGNER_TOKEN TRACEKIT_SIGNER_TOKEN_FILE TRACEKIT_SIGNER_CERT \
  TRACEKIT_SIGNER_KEY TRACEKIT_SIGNER_CA TRACEKIT_RUNTIME_DIR

# hook PYTHON ARGS...: run PYTHON -I ARGS; for any event but BeforeTool, its stdout only if it succeeded
hook() {
  py=$1
  shift
  if [ "$EV" = BeforeTool ]; then
    "$py" -I "$@"
    return
  fi
  out=$("$py" -I "$@")
  s=$?
  [ $s = 0 ] && printf '%s\n' "$out"
  return $s
}

# finish STATUS WHAT FIX [open]: the hook exited STATUS. A BeforeTool it blocked (2) stays blocked, and one it could
# not finish is blocked too (with "open": runs, with the error shown). Any other event's failure is 1; the hook's own
# message (status 1 or 2) comes first, else WHAT and FIX are said here.
finish() {
  [ "$1" = 0 ] && exit 0
  if [ "$EV" = BeforeTool ]; then
    [ "$1" = 2 ] && exit 2
    if [ "${4:-}" = open ]; then
      echo "tracekit extension: $2, so this call was NOT recorded (fail_mode open). $3" >&2
      exit 1
    fi
    echo "tracekit extension: $2, so this call was blocked (fail-closed). $3" >&2
    exit 2
  fi
  [ "$1" = 1 ] || [ "$1" = 2 ] || echo "tracekit extension: $2, so this $EV event was NOT recorded. $3" >&2
  exit 1
}

if [ -e "$SYSTEM_CONFIG" ]; then
  hook "$SYSTEM_PYTHON" -m $HOOK gemini "$@"
  s=$?
  [ $s = 0 ] && exit 0
  grep -Eq '"fail_mode"[[:space:]]*:[[:space:]]*"open"' "$SYSTEM_CONFIG" 2>/dev/null && open=open
  finish $s "$SYSTEM_PYTHON could not run the tracekit hook" "Re-run system init from a root-owned clone: sudo \
/usr/bin/python3 -m tracekit init --v2 --user <agent-user> --agent gemini --no-hooks" "${open:-}"
fi
PATHS='import site, sys; site.addsitedir(site.getusersitepackages())'
RUN="$PATHS"'
import re
pre = sys.argv[1:2] == ["BeforeTool"]
try:
    import tracekit
    from tracekit.integrations.harness_hooks import entry
    why = "" if tuple(map(int, re.findall(r"\d+", tracekit.__version__)[:3])) >= (1, 4, 2) else "is older than 1.4.2"
except Exception as e:
    why = "cannot import its hook (%s: %s)" % (type(e).__name__, e)
if why:
    import tracekit
    print("tracekit extension: tracekit %s in %s %s, so this %s. Upgrade: pip install -U tracekit-ai"
          % (getattr(tracekit, "__version__", "?"), sys.executable, why,
             "call was blocked" if pre else "event was NOT recorded"), file=sys.stderr)
    raise SystemExit(2 if pre else 1)
raise SystemExit(entry("gemini", *sys.argv[1:2]))'
tk=$(command -v tracekit 2>/dev/null) && tkpy=$(sed -n '1s/^#!\(\/[^ ]*\)$/\1/p' "$tk" 2>/dev/null)
for py in ${tkpy:+"$tkpy"} python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -I -c "$PATHS; import tracekit" >/dev/null 2>&1; then
    hook "$py" -c "$RUN" "$@"
    finish $? "$py could not run the tracekit hook" "Reinstall: pip install -U tracekit-ai"
  fi
done
case $(uname -s 2>/dev/null) in
  Darwin) data="$HOME/Library/Application Support/tracekit/data" ;;
  *) data="${XDG_DATA_HOME:-$HOME/.local/share}/tracekit" ;;
esac
if [ -d "$data" ]; then
  finish 3 "no Python here (the tracekit command's, python3, python) has the tracekit package, though Tracekit is set \
up" "Install it (pip install tracekit-ai), or turn the extension off: gemini extensions disable tracekit"
fi
echo "tracekit extension: the tracekit package is not installed for python3, so this $EV event was NOT recorded. Set \
up: pip install tracekit-ai && tracekit init --dev --v2 --no-hooks" >&2
exit 1
